# Supabase injects its project URL and server keys when functions are deployed.
# Configure the following with `supabase secrets set` using test-mode values first.
LEMONSQUEEZY_API_KEY=replace_with_test_mode_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_test_webhook_signing_secret
LEMONSQUEEZY_STORE_ID=replace_with_test_store_id

LEMONSQUEEZY_ELITE_MONTHLY_VARIANT_ID=replace_with_test_elite_monthly_variant_id

