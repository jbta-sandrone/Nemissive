# Supabase injects its project URL and server keys when functions are deployed.
# Configure the following with `supabase secrets set` using test-mode values first.
LEMONSQUEEZY_API_KEY=replace_with_test_mode_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_test_webhook_signing_secret
LEMONSQUEEZY_STORE_ID=replace_with_test_store_id

LEMONSQUEEZY_ELITE_MONTHLY_VARIANT_ID=replace_with_test_elite_monthly_variant_id

LEMONSQUEEZY_OBSIDIAN_VARIANT_ID=replace_with_test_obsidian_variant_id
LEMONSQUEEZY_CELESTIAL_VARIANT_ID=replace_with_test_celestial_variant_id
LEMONSQUEEZY_SAKURA_VARIANT_ID=replace_with_test_sakura_variant_id
LEMONSQUEEZY_EMBER_VARIANT_ID=replace_with_test_ember_variant_id
LEMONSQUEEZY_GLACIER_VARIANT_ID=replace_with_test_glacier_variant_id
LEMONSQUEEZY_VERDANT_VARIANT_ID=replace_with_test_verdant_variant_id
LEMONSQUEEZY_ABYSS_VARIANT_ID=replace_with_test_abyss_variant_id
LEMONSQUEEZY_ECLIPSE_VARIANT_ID=replace_with_test_eclipse_variant_id
LEMONSQUEEZY_DUNE_VARIANT_ID=replace_with_test_dune_variant_id
LEMONSQUEEZY_VOID_VARIANT_ID=replace_with_test_void_variant_id

LEMONSQUEEZY_TEST_MODE=true
NEMISSIVE_APP_URL=http://localhost:5173
